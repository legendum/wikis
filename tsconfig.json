{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "paths": {
      "pues/*": ["./types/pues/*", "./pues/*"]
    }
  },
  "include": ["src/**/*.ts", "cli/**/*.ts", "tests/**/*.ts"]
}
